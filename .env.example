# ============================================================
# 로컬 개발 환경 변수 예시
# - 실사용 시 `.env` 로 복사 후 값 변경
# - `.env` 는 커밋 금지 (.gitignore 필수)
# ============================================================

# ---- Compose 프로젝트 이름 (컨테이너/볼륨/네트워크 prefix)
COMPOSE_PROJECT_NAME=portfolio

# ---- Postgres
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-#strong-passwd
POSTGRES_DB=portfolio
# 호스트 사이드 bind 주소 (WSL2에서 외부 노출 금지 → 127.0.0.1)
PG_HOST_BIND=127.0.0.1
# 호스트 사이드 포트 (네이티브 5432 충돌 회피)
PG_PORT=15432

# ---- Redis
REDIS_PASSWORD=change-me-#strong-passwd
REDIS_HOST_BIND=127.0.0.1
# 호스트 사이드 포트 (네이티브 6379 충돌 회피)
REDIS_PORT=16379

# ---- 애플리케이션용 참고값 (서비스에서 직접 사용 X)
PGVECTOR_DIM=1536
HNSW_EF_SEARCH=40